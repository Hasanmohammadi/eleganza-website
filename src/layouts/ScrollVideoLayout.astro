---
import { ViewTransitions } from 'astro:transitions';
import type { Locale } from '../i18n/translations';
import { locales } from '../i18n/translations';

// این Layout عمداً ساده‌ست و همون چیزیه که تو تست قدم‌به‌قدم (step12) کار کرد:
//  - بدون Lenis و CustomCursor (Layout.astro اصلی این‌ها رو داره)
//  - overflow-x: clip روی html/body، نه hidden (hidden ← body می‌شه scroll container ← sticky خراب می‌شه)
//  - padding امن :root و ViewTransitions (هر دو تو تست اوکی بودن)
interface Props {
  title: string;
  description: string;
  lang: Locale;
}
const { title, description, lang } = Astro.props;
const dir = locales[lang].dir;

const fonts: Record<Locale, { url: string; display: string; body: string }> = {
  en: {
    url: 'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap',
    display: "'Instrument Serif', Georgia, serif",
    body: 'ui-sans-serif, system-ui, sans-serif',
  },
  fa: {
    url: 'https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&display=swap',
    display: "'Vazirmatn', system-ui, sans-serif",
    body: "'Vazirmatn', system-ui, sans-serif",
  },
  ar: {
    url: 'https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@400;500&display=swap',
    display: "'Amiri', serif",
    body: "'Tajawal', system-ui, sans-serif",
  },
};
const f = fonts[lang];
---

<!doctype html>
<html lang={lang} dir={dir} style={`--font-display: ${f.display}; --font-body: ${f.body};`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={f.url} />
    <!-- کتابخونه‌ها از خود سایت سرو می‌شن (public/vendor، با scripts/copy-vendor.mjs کپی می‌شن).
         CDN فقط اگه فایل محلی لود نشد (onerror) به‌عنوان پشتیبان می‌آد. gsap برای شمارنده‌ی آمار لازمه. -->
    <script is:inline src="/vendor/gsap.min.js" onerror="var s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js';document.head.appendChild(s);"></script>
    <script is:inline src="/vendor/scrolly-video.js" onerror="var s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/scrolly-video@0.0.24/dist/scrolly-video.js';document.head.appendChild(s);"></script>
    <ViewTransitions />
    <style is:global>
      body, html, * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: #0D0D0D; font-family: var(--font-body); }
      :root {
        box-sizing: border-box;
        padding-top: env(safe-area-inset-top, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      html, body { overflow-x: clip; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
