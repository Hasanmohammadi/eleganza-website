---
// هدر ثابت + منوی تمام‌صفحه + انتخاب زبان.
// موقع باز بودن منو body.style.overflow = 'hidden' می‌شه (تو step4 اوکی بود).
// لینک‌ها data-astro-reload دارن: چون مقصدشون Layout دیگه‌ایه (Lenis/CustomCursor داره) و
// نمی‌خوایم با swap کلاینت‌ساید اون‌ها وسط این صفحه فعال بشن.
import { locales } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';
import { cinematicContent } from '../../i18n/cinematic';

interface Props { lang: Locale }
const { lang } = Astro.props;
const c = cinematicContent[lang];
const home = `/${lang}/cinematic/`;
---

<nav id="cine-nav">
  <div class="nav-inner">
    <a href={home} data-astro-reload class="reveal-nav nav-logo">ELEGANZA</a>
    <button id="cine-pill" type="button" class="reveal-nav nav-pill" data-navigate={c.navigatePill} data-close={c.closePill}>
      <span class="pill-label">{c.navigatePill}</span>
    </button>
    <div class="reveal-nav nav-mark"><a href={home} data-astro-reload aria-label="Eleganza"><img src="/brand/logo-icon.png" alt="" /></a></div>
    <button id="cine-hamburger" type="button" aria-label="Menu">
      <span class="ham-bar"></span>
      <span class="ham-bar"></span>
    </button>
  </div>
</nav>
<div id="cine-overlay">
  <div class="overlay-inner">
    {c.overlayLinks.map((l, i) => (
      <a href={l.href} data-astro-reload class="overlay-link" style={`transition-delay:${150 + i * 80}ms`}>{l.label}</a>
    ))}
    <div class="overlay-langs">
      {(Object.keys(locales) as Locale[]).map((l) => (
        <a href={`/${l}/cinematic/`} data-astro-reload class={`lang-link${l === lang ? ' is-current' : ''}`} aria-current={l === lang ? 'page' : undefined}>{locales[l].label}</a>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var nav = document.getElementById('cine-nav');
    var pillBtn = document.getElementById('cine-pill');
    var hamburger = document.getElementById('cine-hamburger');
    var overlay = document.getElementById('cine-overlay');
    var links = document.querySelectorAll('.overlay-link');
    var label = pillBtn.querySelector('.pill-label');
    var isOpen = false;

    function toggle() {
      isOpen = !isOpen;
      overlay.classList.toggle('is-open', isOpen);
      hamburger.classList.toggle('is-open', isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
      links.forEach(function (l) { l.classList.toggle('is-in', isOpen); });
      label.textContent = pillBtn.getAttribute(isOpen ? 'data-close' : 'data-navigate');
    }

    pillBtn.addEventListener('click', toggle);
    hamburger.addEventListener('click', toggle);

    // برگشت با دکمه‌ی Back (bfcache): منو نباید باز و بدنه قفل‌شده برگرده
    window.addEventListener('pageshow', function (e) { if (e.persisted && isOpen) toggle(); });

    function updateNav() { nav.classList.toggle('is-scrolled', window.scrollY > 40); }
    window.addEventListener('scroll', updateNav, { passive: true });
    updateNav();
  })();
</script>

<style is:global>
  @keyframes fadeUp { from { opacity: 0; transform: translateY(-16px); } to { opacity: 1; transform: translateY(0); } }
  #cine-nav { position: fixed; top: 0; left: 0; width: 100%; z-index: 50; transition: background-color .5s, backdrop-filter .5s; font-family: var(--font-body); }
  #cine-nav.is-scrolled { background-color: rgba(13,13,13,0.8); backdrop-filter: blur(12px); }
  .nav-inner { max-width: 1440px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; height: 64px; }
  @media (min-width: 768px) { .nav-inner { padding: 0 40px; height: 80px; } }
  .nav-logo { color: #fff; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 1.25rem; font-weight: 600; letter-spacing: -0.02em; text-decoration: none; }
  @media (min-width: 768px) { .nav-logo { font-size: 1.5rem; } }
  .nav-pill { display: none; align-items: center; gap: 8px; padding: 8px 20px; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.9); font-size: 14px; background: transparent; cursor: pointer; transition: background-color .2s; font-family: inherit; }
  .nav-pill:hover { background: rgba(255,255,255,0.1); }
  @media (min-width: 768px) { .nav-pill { display: flex; } }
  .nav-mark { display: none; }
  @media (min-width: 768px) { .nav-mark { display: flex; } }
  .nav-mark img { width: 28px; height: 28px; object-fit: contain; opacity: 0.9; }
  #cine-hamburger { display: flex; width: 32px; height: 32px; flex-direction: column; align-items: center; justify-content: center; gap: 6px; background: none; border: none; cursor: pointer; padding: 0; }
  @media (min-width: 768px) { #cine-hamburger { display: none; } }
  .ham-bar { width: 24px; height: 2px; background: #fff; transition: transform .5s cubic-bezier(.76,0,.24,1); }
  #cine-hamburger.is-open .ham-bar:first-child { transform: rotate(45deg) translateY(6px); }
  #cine-hamburger.is-open .ham-bar:last-child { transform: rotate(-45deg) translateY(-6px); }
  .reveal-nav { opacity: 0; animation: fadeUp .7s cubic-bezier(.16,1,.3,1) forwards; }
  #cine-pill { animation-delay: .2s; }
  .nav-mark { animation-delay: .4s; }

  #cine-overlay { position: fixed; inset: 0; z-index: 40; background: #0D0D0D; opacity: 0; visibility: hidden; transition: opacity .7s cubic-bezier(.76,0,.24,1); }
  #cine-overlay.is-open { opacity: 1; visibility: visible; }
  .overlay-inner { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32px; }
  .overlay-link { color: #fff; text-decoration: none; font-family: var(--font-display); font-size: 2.5rem; line-height: 1.2; opacity: 0; transform: translateY(24px); transition: opacity .6s cubic-bezier(.76,0,.24,1), transform .6s cubic-bezier(.76,0,.24,1); }
  @media (min-width: 768px) { .overlay-link { font-size: 4rem; } }
  .overlay-link:hover { opacity: 0.6; }
  .overlay-link.is-in { opacity: 1 !important; transform: translateY(0) !important; }
  .overlay-langs { display: flex; gap: 10px; margin-top: 12px; opacity: 0; transition: opacity .6s cubic-bezier(.76,0,.24,1) .5s; }
  #cine-overlay.is-open .overlay-langs { opacity: 1; }
  .lang-link { color: rgba(255,255,255,0.7); font-family: var(--font-body); font-size: 13px; text-decoration: none; padding: 6px 14px; border: 1px solid rgba(255,255,255,0.2); border-radius: 9999px; }
  .lang-link:hover { border-color: #D4AF37; color: #fff; }
  .lang-link.is-current { background: #D4AF37; border-color: #D4AF37; color: #0D0D0D; }
</style>
