---
// متن‌های شناور روی ویدیو؛ هرکدوم فقط تو بازه‌ی درصدی خودش (data-start/data-end) دیده می‌شه.
import { translations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';
import { cinematicContent } from '../../i18n/cinematic';
import { scrollVideoContent } from '../../i18n/scrollvideo';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = translations[lang];
const c = cinematicContent[lang];
const s = scrollVideoContent[lang];
---

<div class="fixed-overlay ov-hero" data-start="0" data-end="0.14">
  <span class="ov-eyebrow">{s.eyebrow}</span>
  <h1 class="ov-title">{s.titleLine1}<br />{s.titleLine2}</h1>
  <p class="ov-sub">{s.sub}</p>
  <a href={`/${lang}/`} data-astro-reload class="ov-cta">{c.cta}</a>
</div>
<div class="fixed-overlay" data-start="0.18" data-end="0.32"><div class="ov-phrase">{t.pillars[0].title}</div></div>
<div class="fixed-overlay" data-start="0.36" data-end="0.50"><div class="ov-phrase">{t.pillars[1].title}</div></div>
<div class="fixed-overlay" data-start="0.54" data-end="0.68"><div class="ov-phrase">{t.pillars[2].title}</div></div>

<script is:inline>
  (function () {
    function init() {
      // بعد از پارس کامل صفحه اجرا می‌شه تا overlayهای کامپوننت‌های بعدی (مثل آمار) هم پیدا بشن
      var wrap = document.querySelector('.wrap');
      var overlays = [].slice.call(document.querySelectorAll('.fixed-overlay')).map(function (el) {
        return { el: el, start: parseFloat(el.dataset.start), end: parseFloat(el.dataset.end) };
      });

      function onScroll() {
        var rect = wrap.getBoundingClientRect();
        var total = rect.height - window.innerHeight;
        var progress = Math.min(1, Math.max(0, -rect.top / total));
        overlays.forEach(function (o) {
          o.el.classList.toggle('is-visible', progress >= o.start && progress <= o.end);
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>

<style is:global>
  .fixed-overlay {
    position: fixed; inset: 0; z-index: 15;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 0 24px; pointer-events: none;
    opacity: 0; transition: opacity 0.6s ease;
  }
  .fixed-overlay.is-visible { opacity: 1; }
  /* هیرو: کنارچین به‌جای وسط‌چین، سمت گرادیان تیره (مثل نمونه‌ی مرجع) */
  .ov-hero { align-items: flex-start; text-align: start; padding-inline-start: 6vw; padding-inline-end: 24px; max-width: 680px; margin-inline-end: auto; }
  @media (min-width: 1024px) { .ov-hero { padding-inline-start: 8vw; } }

  .ov-eyebrow { color: #F3E6B3; font-family: var(--font-body); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 18px; text-shadow: 0 1px 20px rgba(0,0,0,0.6); }
  .ov-title { font-family: var(--font-display); font-weight: 400; color: #fff; font-size: 2.25rem; line-height: 1; margin-bottom: 18px; text-shadow: 0 2px 40px rgba(0,0,0,0.6); }
  @media (min-width: 768px) { .ov-title { font-size: 4rem; } }
  .ov-sub { color: rgba(255,255,255,0.78); font-family: var(--font-body); font-size: 1rem; line-height: 1.6; max-width: 26rem; margin-bottom: 28px; text-shadow: 0 1px 20px rgba(0,0,0,0.6); }
  .ov-cta { display: inline-block; padding: 14px 32px; background: #fff; color: #000; font-family: var(--font-body); font-size: 14px; font-weight: 500; border-radius: 9999px; text-decoration: none; pointer-events: auto; }
  /* CTA فقط وقتی متنش دیده می‌شه قابل کلیکه (وگرنه یه هدف کلیک نامرئی وسط صفحه می‌مونه) */
  .fixed-overlay:not(.is-visible) .ov-cta { pointer-events: none; }
  .ov-phrase { font-family: var(--font-display); font-weight: 400; font-size: 2.75rem; line-height: 1.1; color: #F3E6B3; text-shadow: 0 2px 40px rgba(0,0,0,0.6); }
  @media (min-width: 768px) { .ov-phrase { font-size: 5rem; } }

  /* فارسی و عربی: letter-spacing حروف رو از هم جدا می‌کنه، و خط‌ارتفاع ۱ حرکات/نقطه‌ها رو می‌بره */
  html[lang='fa'] .ov-eyebrow, html[lang='ar'] .ov-eyebrow { letter-spacing: 0; text-transform: none; font-size: 14px; }
  html[lang='fa'] .ov-title, html[lang='ar'] .ov-title { line-height: 1.35; }
  html[lang='fa'] .ov-phrase, html[lang='ar'] .ov-phrase { line-height: 1.4; }
  html[lang='fa'] .ov-title, html[lang='fa'] .ov-phrase { font-weight: 600; }
  html[lang='ar'] .ov-title, html[lang='ar'] .ov-phrase { font-weight: 700; }
</style>
