---
import LanguageSwitcher from './LanguageSwitcher.astro';
import EmblemMark from './EmblemMark.astro';
import IndustryRing from './IndustryRing.astro';
import type { Locale, Translation } from '../i18n/translations';

interface Props {
  lang: Locale;
  t: Translation;
}

const { lang, t } = Astro.props;

const pillarIcons = [
  // Target
  '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>',
  // Lightbulb
  '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2.3h6c0-1.1.4-1.8 1-2.3A7 7 0 0 0 12 2Z"/>',
  // Infinity
  '<path d="M8.5 8a4 4 0 1 0 0 8c2.5 0 3.8-2 4.5-4 .7-2 2-4 4.5-4a4 4 0 1 1 0 8c-2.5 0-3.8-2-4.5-4-.7-2-2-4-4.5-4Z"/>',
];
---

<main class="relative min-h-screen overflow-hidden flex flex-col">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="blob blob-1 absolute w-[36rem] h-[36rem] rounded-full bg-navy/60 blur-3xl"></div>
    <div class="blob blob-2 absolute w-[26rem] h-[26rem] rounded-full bg-gold/10 blur-3xl"></div>
    <div class="blob blob-3 absolute w-[20rem] h-[20rem] rounded-full bg-platinum/5 blur-3xl"></div>
  </div>

  <div class="particles pointer-events-none absolute inset-0 -z-10 overflow-hidden"></div>

  <header class="w-full flex justify-between items-center px-6 md:px-12 py-6 md:py-8">
    <div class="emblem-wrap opacity-0">
      <EmblemMark class="w-8 h-8 md:w-9 md:h-9" />
    </div>
    <div class="lang-wrap opacity-0">
      <LanguageSwitcher current={lang} />
    </div>
  </header>

  <div class="flex-1 flex flex-col items-center justify-center px-6 text-center py-8">
    <span class="cs-badge opacity-0 mb-6 px-4 py-1.5 rounded-sm text-[11px] md:text-xs tracking-widest2 uppercase border border-gold/40 text-gold-light">
      {t.badge}
    </span>

    <div class="cs-brand opacity-0 mb-3">
      <h1 class="brand-title font-display text-4xl sm:text-6xl md:text-7xl font-semibold tracking-wide">
        {t.brandLine1}
      </h1>
      <p class="mt-2 text-xs sm:text-sm tracking-widest2 uppercase text-platinum">
        {t.brandLine2}
      </p>
    </div>

    <h2 class="cs-headline opacity-0 font-display text-xl sm:text-2xl md:text-3xl text-warmwhite max-w-2xl mt-6">
      {t.headline}
    </h2>

    <p class="cs-subtitle opacity-0 mt-4 text-platinum max-w-md text-sm sm:text-base">
      {t.subtitle}
    </p>

    <div class="cs-ring opacity-0 mt-10 md:mt-12">
      <IndustryRing industries={t.industries} label={t.industriesLabel} />
    </div>

    <div class="cs-countdown opacity-0 mt-10 md:mt-12 grid grid-cols-4 gap-3 md:gap-6" dir="ltr">
      <div class="countdown-box flex flex-col items-center min-w-[58px] md:min-w-[76px]">
        <span class="countdown-num font-display text-2xl sm:text-4xl text-gold-light tabular-nums" data-unit="days">00</span>
        <span class="w-6 h-px bg-gold/50 my-1.5"></span>
        <span class="text-[10px] md:text-xs text-platinum uppercase tracking-wide">{t.days}</span>
      </div>
      <div class="countdown-box flex flex-col items-center min-w-[58px] md:min-w-[76px]">
        <span class="countdown-num font-display text-2xl sm:text-4xl text-gold-light tabular-nums" data-unit="hours">00</span>
        <span class="w-6 h-px bg-gold/50 my-1.5"></span>
        <span class="text-[10px] md:text-xs text-platinum uppercase tracking-wide">{t.hours}</span>
      </div>
      <div class="countdown-box flex flex-col items-center min-w-[58px] md:min-w-[76px]">
        <span class="countdown-num font-display text-2xl sm:text-4xl text-gold-light tabular-nums" data-unit="minutes">00</span>
        <span class="w-6 h-px bg-gold/50 my-1.5"></span>
        <span class="text-[10px] md:text-xs text-platinum uppercase tracking-wide">{t.minutes}</span>
      </div>
      <div class="countdown-box flex flex-col items-center min-w-[58px] md:min-w-[76px]">
        <span class="countdown-num font-display text-2xl sm:text-4xl text-gold-light tabular-nums" data-unit="seconds">00</span>
        <span class="w-6 h-px bg-gold/50 my-1.5"></span>
        <span class="text-[10px] md:text-xs text-platinum uppercase tracking-wide">{t.seconds}</span>
      </div>
    </div>

    <form class="cs-form opacity-0 mt-10 w-full max-w-md flex flex-col sm:flex-row gap-3" id="notify-form">
      <input
        type="email"
        required
        placeholder={t.emailPlaceholder}
        class="flex-1 px-4 py-3 bg-transparent border border-platinum/30 text-sm text-warmwhite placeholder:text-platinum/60 focus:outline-none focus:border-gold transition-colors"
      />
      <button type="submit" class="notify-btn relative overflow-hidden px-6 py-3 text-sm font-medium tracking-wide text-charcoal">
        <span class="relative z-10">{t.notifyBtn}</span>
      </button>
    </form>
    <p class="cs-success hidden mt-4 text-sm text-gold-light">{t.successMsg}</p>

    <div class="cs-pillars opacity-0 mt-14 md:mt-16 grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-4 max-w-3xl w-full border-t border-platinum/15 pt-8">
      {
        t.pillars.map((pillar, i) => (
          <div class="pillar-item flex flex-col items-center gap-2 px-2">
            <span class="pillar-icon inline-block text-gold">
              <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={pillarIcons[i]} />
            </span>
            <span class="font-display text-sm sm:text-base text-warmwhite">{pillar.title}</span>
            <span class="text-xs text-platinum">{pillar.description}</span>
          </div>
        ))
      }
    </div>
  </div>

  <footer class="cs-footer opacity-0 text-center text-xs text-platinum/60 py-6">
    &copy; {new Date().getFullYear()} {t.brandLine1} {t.brandLine2} — {t.footer}
  </footer>
</main>

<style>
  .brand-title {
    background-image: linear-gradient(120deg, #f3e6b3 0%, #d4af37 35%, #f7f6f2 50%, #d4af37 65%, #f3e6b3 100%);
    background-size: 250% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .notify-btn {
    background: linear-gradient(135deg, #f3e6b3, #d4af37);
  }
  .notify-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255, 255, 255, 0.55) 50%, transparent 70%);
    background-size: 250% 100%;
    background-position: 150% 0;
  }
  .notify-btn:hover::after {
    transition: background-position 0.7s ease;
    background-position: -50% 0;
  }

  .blob {
    animation: float 14s ease-in-out infinite;
  }
  .blob-1 {
    top: -15%;
    inset-inline-start: -12%;
  }
  .blob-2 {
    bottom: -8%;
    inset-inline-end: -8%;
    animation-delay: -5s;
  }
  .blob-3 {
    top: 35%;
    inset-inline-start: 45%;
    animation-delay: -9s;
  }
  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(4%, 6%) scale(1.1); }
  }

  .pillar-icon {
    display: inline-block;
  }
</style>

<script>
  import gsap from 'gsap';

  const tl = gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.9 } });

  tl.fromTo('.emblem-wrap', { opacity: 0, y: -16, rotate: -15 }, { opacity: 1, y: 0, rotate: 0, duration: 0.8, ease: 'back.out(2)' })
    .fromTo('.lang-wrap', { opacity: 0, y: -10 }, { opacity: 1, y: 0 }, '<0.1')
    .fromTo('.cs-badge', { opacity: 0, y: 14, scale: 0.8 }, { opacity: 1, y: 0, scale: 1, ease: 'back.out(2.5)' }, '-=0.3')
    .fromTo('.cs-brand', { opacity: 0, y: 30, scale: 0.92 }, { opacity: 1, y: 0, scale: 1, duration: 1.1 }, '-=0.4')
    .fromTo('.cs-headline', { opacity: 0, y: 22 }, { opacity: 1, y: 0 }, '-=0.7')
    .fromTo('.cs-subtitle', { opacity: 0, y: 18 }, { opacity: 1, y: 0 }, '-=0.6')
    .fromTo('.cs-ring', { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 1 }, '-=0.4')
    .fromTo('.countdown-box', { opacity: 0, y: 20, rotateX: -40 }, { opacity: 1, y: 0, rotateX: 0, stagger: 0.1, ease: 'back.out(2)' }, '-=0.5')
    .to('.cs-countdown', { opacity: 1, duration: 0.3 }, '<')
    .fromTo('.cs-form', { opacity: 0, y: 18 }, { opacity: 1, y: 0 }, '-=0.3')
    .fromTo('.pillar-item', { opacity: 0, y: 24, scale: 0.85 }, { opacity: 1, y: 0, scale: 1, stagger: 0.15, ease: 'back.out(2)' }, '-=0.2')
    .to('.cs-pillars', { opacity: 1, duration: 0.3 }, '<')
    .fromTo('.cs-footer', { opacity: 0 }, { opacity: 1, duration: 0.6 }, '-=0.2');

  gsap.to('.brand-title', { backgroundPosition: '250% center', duration: 6, repeat: -1, ease: 'none' });
  gsap.to('.emblem-wrap', { y: -6, duration: 2.6, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 1.5 });
  gsap.to('.cs-badge', { scale: 1.05, duration: 1.8, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 1.5 });

  gsap.utils.toArray('.pillar-icon').forEach((icon: any, i: number) => {
    gsap.to(icon, {
      rotate: 8,
      duration: 2.2,
      repeat: -1,
      yoyo: true,
      ease: 'sine.inOut',
      delay: 2 + i * 0.3,
    });
  });

  const particleContainer = document.querySelector('.particles');
  if (particleContainer) {
    const count = window.innerWidth < 640 ? 14 : 26;
    for (let i = 0; i < count; i++) {
      const p = document.createElement('div');
      const size = Math.random() * 3 + 1.5;
      p.style.position = 'absolute';
      p.style.width = `${size}px`;
      p.style.height = `${size}px`;
      p.style.borderRadius = '9999px';
      p.style.background = Math.random() > 0.5 ? '#D4AF37' : '#F3E6B3';
      p.style.opacity = `${Math.random() * 0.4 + 0.15}`;
      p.style.left = `${Math.random() * 100}%`;
      p.style.top = `${Math.random() * 100}%`;
      particleContainer.appendChild(p);

      gsap.to(p, {
        y: `-=${Math.random() * 120 + 60}`,
        x: `+=${(Math.random() - 0.5) * 60}`,
        opacity: 0,
        duration: Math.random() * 6 + 6,
        repeat: -1,
        delay: Math.random() * 6,
        ease: 'sine.inOut',
      });
    }
  }

  const target = new Date();
  target.setDate(target.getDate() + 30);

  const daysEl = document.querySelector('[data-unit="days"]') as HTMLElement;
  const hoursEl = document.querySelector('[data-unit="hours"]') as HTMLElement;
  const minutesEl = document.querySelector('[data-unit="minutes"]') as HTMLElement;
  const secondsEl = document.querySelector('[data-unit="seconds"]') as HTMLElement;

  function pad(n: number): string {
    return n.toString().padStart(2, '0');
  }

  function popIfChanged(el: HTMLElement | null, value: string) {
    if (!el || el.textContent === value) return;
    el.textContent = value;
    gsap.fromTo(el, { scale: 1.35, color: '#F7F6F2' }, { scale: 1, color: '#F3E6B3', duration: 0.4, ease: 'back.out(3)' });
  }

  function tick(): void {
    const diff = Math.max(0, target.getTime() - Date.now());
    popIfChanged(daysEl, pad(Math.floor(diff / (1000 * 60 * 60 * 24))));
    popIfChanged(hoursEl, pad(Math.floor((diff / (1000 * 60 * 60)) % 24)));
    popIfChanged(minutesEl, pad(Math.floor((diff / (1000 * 60)) % 60)));
    popIfChanged(secondsEl, pad(Math.floor((diff / 1000) % 60)));
  }

  tick();
  setInterval(tick, 1000);

  const form = document.getElementById('notify-form') as HTMLFormElement | null;
  const successMsg = document.querySelector('.cs-success') as HTMLElement | null;

  form?.addEventListener('submit', (e: SubmitEvent) => {
    e.preventDefault();
    form.reset();
    if (successMsg) {
      successMsg.classList.remove('hidden');
      gsap.fromTo(successMsg, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.4 });
    }
  });
</script>
