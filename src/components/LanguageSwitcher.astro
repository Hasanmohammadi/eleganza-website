---
import type { Locale } from '../i18n/translations';
import { locales } from '../i18n/translations';

interface Props {
  current: Locale;
}

const { current } = Astro.props;
const langs = Object.keys(locales) as Locale[];
---

<div class="lang-switcher flex gap-2">
  {
    langs.map((lang) => (
      <a
        href={`/${lang}/`}
        class={`lang-btn px-3 py-1.5 rounded-sm text-xs tracking-wide border transition-colors ${
          lang === current
            ? 'bg-gold border-gold text-charcoal font-medium'
            : 'border-platinum/30 text-platinum hover:border-gold/60 hover:text-gold'
        }`}
      >
        {locales[lang].label}
      </a>
    ))
  }
</div>

<style>
  .lang-btn {
    transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .lang-btn:hover {
    transform: translateY(-2px);
  }
</style>
