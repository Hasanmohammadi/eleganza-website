---
import EmblemMark from '../EmblemMark.astro';
import type { Locale } from '../../i18n/translations';
import { locales } from '../../i18n/translations';
import type { HomeContent } from '../../i18n/home';

interface Props {
  lang: Locale;
  h: HomeContent;
}
const { lang, h } = Astro.props;
const langs = Object.keys(locales) as Locale[];
---

<header class="site-header fixed top-0 inset-x-0 z-50 border-b border-platinum/10 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between">
    <a href={`/${lang}/`} class="flex items-center gap-2.5 shrink-0" transition:name="brand-emblem">
      <EmblemMark class="w-7 h-7 md:w-8 md:h-8" />
      <span class="hidden sm:block font-display text-sm md:text-base tracking-widest2 uppercase text-warmwhite">
        Eleganza
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-8">
      {h.nav.map((item) => (
        <a href={item.href} class="text-sm text-platinum hover:text-gold transition-colors">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden md:flex gap-1.5">
        {langs.map((l) => (
          <a
            href={`/${l}/home/`}
            class={`px-2.5 py-1 rounded-sm text-[11px] tracking-wide border transition-colors ${
              l === lang ? 'bg-gold border-gold text-charcoal' : 'border-platinum/25 text-platinum hover:border-gold/60 hover:text-gold'
            }`}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
      <a
        href="#contact"
        class="hidden sm:inline-block px-5 py-2 text-xs md:text-sm font-medium tracking-wide text-charcoal"
        style="background: linear-gradient(135deg, #F3E6B3, #D4AF37);"
      >
        {h.navCta}
      </a>
      <button id="mobile-menu-btn" class="lg:hidden text-warmwhite p-2" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>

  <!-- منوی موبایل -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-platinum/10 bg-charcoal">
    <nav class="flex flex-col px-6 py-4 gap-3">
      {h.nav.map((item) => (
        <a href={item.href} class="text-sm text-platinum hover:text-gold transition-colors py-1">
          {item.label}
        </a>
      ))}
      <div class="flex gap-1.5 pt-2">
        {langs.map((l) => (
          <a
            href={`/${l}/home/`}
            class={`px-2.5 py-1 rounded-sm text-[11px] tracking-wide border ${
              l === lang ? 'bg-gold border-gold text-charcoal' : 'border-platinum/25 text-platinum'
            }`}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: rgba(13, 13, 13, 0.5);
    transition: background-color 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .site-header.is-scrolled {
    background-color: rgba(13, 13, 13, 0.88);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    border-color: rgba(212, 175, 55, 0.15);
  }
</style>

<script>
  function initHeader() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

    // بعد از عبور از هیرو، هدر کمی تیره‌تر و با سایه می‌شه
    const header = document.querySelector('.site-header');
    if (!header) return;
    function updateHeaderState() {
      if (window.scrollY > 60) header!.classList.add('is-scrolled');
      else header!.classList.remove('is-scrolled');
    }
    updateHeaderState();
    window.addEventListener('scroll', updateHeaderState, { passive: true });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
