---
import type { HomeContent } from '../../i18n/home';
interface Props { h: HomeContent }
const { h } = Astro.props;
---

<section id="business" class="reveal-section max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24">
  <h2 class="explore-title font-display text-2xl sm:text-3xl md:text-4xl text-warmwhite mb-10 md:mb-12">
    {h.explore.sectionTitle}
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6" style="perspective: 1200px;">
    {h.explore.cards.map((card) => (
      <a href="#" class="explore-card tilt-card group relative overflow-hidden aspect-[4/5] block border border-platinum/10">
        <img src={card.image} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
        <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(13,13,13,0.1) 0%, rgba(13,13,13,0.92) 85%);"></div>
        <div class="relative h-full flex flex-col justify-end p-5 md:p-6" style="transform: translateZ(40px);">
          <h3 class="font-display text-lg md:text-xl text-warmwhite mb-2">{card.title}</h3>
          <p class="text-xs md:text-sm text-platinum leading-relaxed mb-3">{card.description}</p>
          <span class="text-xs tracking-wide text-gold-light inline-flex items-center gap-1">
            {card.cta}
            <span class="transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1">&rarr;</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
