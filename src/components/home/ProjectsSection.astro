---
import type { HomeContent } from '../../i18n/home';
import type { Locale } from '../../i18n/translations';

interface Props {
  h: HomeContent;
  lang: Locale;
}
const { h, lang } = Astro.props;
const isLatin = lang === 'en';
const pr = h.projects;

// عکس‌ها: public/projects/project-1.jpg … project-6.jpg (موقتی؛ با همین اسم جایگزین کن)
// هر پروژه به کدوم حوزه مربوطه (برای انتخاب خودکار «نوع پروژه» تو فرم تماس)
const typeOf = [0, 0, 0, 1, 0, 2];
const items = pr.items.map((p, i) => ({ ...p, image: `/projects/project-${i + 1}.jpg`, type: typeOf[i] ?? 0 }));
---

<!-- سکشن پروژه‌های منتخب: هدر سه‌بخشی + گرید ۳×۲ -->
<section id="projects" class="proj-sec relative overflow-hidden py-20 md:py-28">
  <div class="proj-bg pointer-events-none absolute inset-0"></div>

  <div class="relative max-w-[100rem] mx-auto px-5 md:px-8 xl:px-10">
    <!-- هدر -->
    <div class="proj-head grid gap-6 lg:gap-10 lg:grid-cols-[auto_minmax(0,1fr)_auto] lg:items-center mb-10 md:mb-12 lg:px-12">
      <div>
        <div class="proj-reveal flex items-center gap-4 mb-5">
          <span class="proj-rule block h-px w-12 md:w-16 bg-gold/80 shrink-0"></span>
          <span class={`text-[11px] md:text-[13px] font-medium text-gold-light ${isLatin ? 'uppercase tracking-[0.3em]' : ''}`}>{pr.eyebrow}</span>
        </div>
        <h2 class="font-display text-warmwhite text-[2.4rem] leading-[1.06] sm:text-6xl lg:text-[4.2rem]">
          <span class="proj-line line-mask block"><span class="proj-line-inner block">{pr.title}</span></span>
          <span class="proj-line line-mask block">
            <span class="proj-line-inner block bg-clip-text text-transparent" style="background-image: linear-gradient(100deg, #F3E6B3 0%, #E6C878 45%, #D4AF37 100%);">{pr.highlight}</span>
          </span>
        </h2>
      </div>
      <p class="proj-reveal text-platinum/90 text-[0.95rem] md:text-lg leading-[1.7] max-w-[32rem] lg:ms-6">{pr.subtitle}</p>
      <a href="#contact" class={`proj-reveal proj-cta inline-flex items-center justify-center gap-4 self-start lg:self-center px-8 py-4 rounded-full border border-gold/70 text-gold-light text-[12px] md:text-[13px] font-medium ${isLatin ? 'uppercase tracking-[0.22em]' : ''}`}>
        <span>{pr.cta}</span>
        <svg class="proj-arrow w-5 h-5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" /></svg>
      </a>
    </div>

    <!-- کارت‌ها -->
    <div class="proj-grid grid gap-3 md:gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((p) => (
        <a href="#contact" data-project-type={p.type} class="proj-card group relative flex flex-col overflow-hidden rounded-[6px] border border-white/[0.07]">
          <div class="proj-media relative overflow-hidden">
            <img src={p.image} alt={p.title} loading="lazy" decoding="async" class="proj-img absolute inset-0 w-full h-full object-cover" />
            <div class="proj-media-fade absolute inset-0 pointer-events-none"></div>
          </div>
          <div class="proj-body relative flex items-end gap-4 px-6 md:px-7 pb-6 pt-1 -mt-10">
            <div class="flex-1 min-w-0">
              <span class={`block text-[11px] md:text-[12px] font-medium text-gold ${isLatin ? 'uppercase tracking-[0.18em]' : ''}`}>{p.category}</span>
              <h3 class="font-display mt-2 text-[1.45rem] md:text-[1.6rem] xl:text-[1.75rem] leading-[1.15] text-warmwhite">{p.title}</h3>
              <span class="block mt-1.5 text-[13px] md:text-sm text-platinum">{p.location}</span>
            </div>
            <span class="proj-go shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-full border border-gold/80 text-gold-light transition-all duration-300">
              <svg class="proj-arrow w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .proj-bg {
    background:
      radial-gradient(ellipse 35% 45% at 88% 0%, rgba(212, 175, 55, 0.08), transparent 70%),
      radial-gradient(ellipse 60% 50% at 90% 100%, rgba(11, 31, 58, 0.3), transparent 70%),
      linear-gradient(180deg, #0b0b0b, #0e0f12 50%, #0b0b0b);
  }
  .proj-card {
    background: #111216;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.4s ease, box-shadow 0.5s ease;
  }
  .proj-media {
    aspect-ratio: 16 / 7.6;
    flex-grow: 1; /* اگه تیتر یه کارت دو خطی شد، عکس بقیه‌ی کارت‌های همون ردیف کش میاد تا پایین‌ها هم‌تراز بمونن */
  }
  .proj-media-fade {
    background: linear-gradient(180deg, transparent 50%, rgba(17, 18, 22, 0.7) 78%, #111216 100%);
  }
  .proj-img {
    transform: scale(1.02);
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.6s ease;
    filter: brightness(0.94);
  }
  .proj-body {
    z-index: 1;
  }
  .proj-card:hover {
    transform: translateY(-5px);
    border-color: rgba(212, 175, 55, 0.4);
    box-shadow: 0 26px 60px -28px rgba(0, 0, 0, 0.9);
  }
  .proj-card:hover .proj-img {
    transform: scale(1.08);
    filter: brightness(1.03);
  }
  .proj-card:hover .proj-go,
  .proj-cta:hover {
    background: linear-gradient(135deg, #f3e6b3, #d4af37);
    color: #111;
    border-color: transparent;
  }
  .proj-cta {
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .proj-cta:hover .proj-arrow {
    translate: 4px 0;
  }
  :global([dir='rtl']) .proj-arrow {
    transform: scaleX(-1);
  }
  :global([dir='rtl']) .proj-cta:hover .proj-arrow {
    translate: -4px 0;
  }

  /* موبایل: سوایپ افقی */
  @media (max-width: 639px) {
    .proj-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
      padding-bottom: 0.5rem;
      scroll-padding-inline: 1.25rem;
      scrollbar-width: none;
    }
    .proj-grid::-webkit-scrollbar {
      display: none;
    }
    .proj-card {
      flex: 0 0 86%;
      scroll-snap-align: start;
    }
    .proj-media {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proj-card, .proj-img { transition: none; }
    .proj-card:hover { transform: none; }
  }
</style>

<script>
  import gsap from 'gsap';

  function initProjects() {
    const section = document.querySelector('.proj-sec') as HTMLElement | null;
    if (!section || section.dataset.inited) return;
    section.dataset.inited = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
      gsap.registerPlugin(ScrollTrigger);
      const isRtl = document.documentElement.dir === 'rtl';

      gsap.timeline({ defaults: { ease: 'power3.out' }, scrollTrigger: { trigger: section, start: 'top 75%', once: true } })
        .from(section.querySelector('.proj-rule'), { scaleX: 0, transformOrigin: isRtl ? 'right center' : 'left center', duration: 0.8 }, 0)
        .from(section.querySelectorAll('.proj-line-inner'), { yPercent: 165, duration: 1.1, stagger: 0.12, ease: 'expo.out' }, 0.1)
        .from(section.querySelectorAll('.proj-reveal'), { opacity: 0, y: 22, duration: 0.9, stagger: 0.12 }, 0.25);

      // کارت‌ها: هر ردیف با هم، عکس با پرده‌ی عمودی
      section.querySelectorAll<HTMLElement>('.proj-card').forEach((card, i) => {
        gsap.timeline({
          defaults: { ease: 'power3.out' },
          scrollTrigger: { trigger: card, start: 'top 88%', once: true },
          delay: (i % 3) * 0.12,
        })
          .from(card, { opacity: 0, y: 44, duration: 0.9 }, 0)
          .from(card.querySelector('.proj-media'), { clipPath: 'inset(0 0 100% 0)', duration: 1.2, ease: 'expo.inOut', clearProps: 'clipPath' }, 0.05)
          .from(card.querySelector('.proj-img'), { scale: 1.25, duration: 1.6, ease: 'expo.out', clearProps: 'transform' }, 0.05)
          .from(card.querySelectorAll('.proj-body > div > *, .proj-go'), { opacity: 0, y: 12, duration: 0.6, stagger: 0.07 }, 0.5);
      });
    });
  }

  document.addEventListener('astro:page-load', initProjects);
</script>
