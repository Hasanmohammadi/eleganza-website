---
import type { HomeContent } from '../../i18n/home';
interface Props { h: HomeContent }
const { h } = Astro.props;
---

<section id="news" class="reveal-section max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24">
  <div class="flex items-center justify-between mb-10 md:mb-12">
    <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-warmwhite">{h.news.sectionTitle}</h2>
    <a href="#" class="hidden sm:inline text-sm text-gold border-b border-gold/40 hover:border-gold pb-0.5 transition-colors whitespace-nowrap">
      {h.news.viewAll} &rarr;
    </a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
    {h.news.items.map((item) => (
      <a href="#" class="news-card group block">
        <div class="relative overflow-hidden aspect-[3/2] border border-platinum/10 mb-4">
          <img src={item.image} alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
        </div>
        <span class="text-[11px] tracking-widest2 uppercase text-gold">{item.category}</span>
        <h3 class="font-display text-base md:text-lg text-warmwhite mt-2 mb-2 leading-snug group-hover:text-gold-light transition-colors">
          {item.title}
        </h3>
        <p class="text-sm text-platinum leading-relaxed mb-2">{item.excerpt}</p>
        <span class="text-xs text-platinum/60">{item.date}</span>
      </a>
    ))}
  </div>
</section>
