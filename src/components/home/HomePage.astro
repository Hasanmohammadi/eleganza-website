---
import Header from './Header.astro';
import Hero from './Hero.astro';
import StatsBar from './StatsBar.astro';
import Intro from './Intro.astro';
import ExploreGrid from './ExploreGrid.astro';
import IndustriesSection from './IndustriesSection.astro';
import WhyChoose from './WhyChoose.astro';
import ProcessSteps from './ProcessSteps.astro';
import NewsSection from './NewsSection.astro';
import EventsSection from './EventsSection.astro';
import Footer from './Footer.astro';
import type { Locale } from '../../i18n/translations';
import type { HomeContent } from '../../i18n/home';

interface Props {
  lang: Locale;
  h: HomeContent;
}
const { lang, h } = Astro.props;
---

<div class="bg-charcoal">
  <Header lang={lang} h={h} />
  <Hero h={h} />
  <StatsBar h={h} />
  <Intro h={h} />
  <ExploreGrid h={h} />
  <IndustriesSection h={h} />
  <WhyChoose h={h} />
  <ProcessSteps h={h} />
  <NewsSection h={h} />
  <EventsSection h={h} />
  <Footer lang={lang} h={h} />
</div>

<script>
  import gsap from 'gsap';

  function initHomePage() {
    const sections = document.querySelectorAll('.reveal-section');
    if (!sections.length) return; // یعنی توی صفحه‌ی دیگه‌ای هستیم (نه Home Preview)

    import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
      gsap.registerPlugin(ScrollTrigger);

      // برای هر سکشن، فرزندهای مستقیمی که کارت/آیتم هستن رو موقع رسیدن به دید انیمیت می‌کنیم
      const itemSelectors = '.stat-item, .explore-card, .industry-card, .feature-item, .step-item, .news-card, .event-card';

      sections.forEach((section) => {
        const items = section.querySelectorAll(itemSelectors);
        const heading = section.querySelector('h2:not(.intro-heading)');

        if (heading) {
          gsap.fromTo(
            heading,
            { opacity: 0, y: 24 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power3.out',
              scrollTrigger: { trigger: section, start: 'top 82%' },
            }
          );
        }

        if (items.length) {
          gsap.fromTo(
            items,
            { opacity: 0, y: 28, scale: 0.96 },
            {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 0.7,
              stagger: 0.08,
              ease: 'back.out(1.7)',
              scrollTrigger: { trigger: section, start: 'top 78%' },
            }
          );
        }
      });
    });

    // ---------- تیلت سه‌بعدی کارت‌ها با موس (فقط روی دستگاه‌هایی که هاور دارن) ----------
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced && window.matchMedia('(hover: hover)').matches) {
      document.querySelectorAll<HTMLElement>('.tilt-card').forEach((card) => {
        const rotateX = gsap.quickTo(card, 'rotateX', { duration: 0.5, ease: 'power3.out' });
        const rotateY = gsap.quickTo(card, 'rotateY', { duration: 0.5, ease: 'power3.out' });
        gsap.set(card, { transformPerspective: 800, transformStyle: 'preserve-3d' });

        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width - 0.5;
          const py = (e.clientY - rect.top) / rect.height - 0.5;
          rotateY(px * 12);
          rotateX(py * -12);
        });
        card.addEventListener('mouseleave', () => {
          rotateX(0);
          rotateY(0);
        });
      });
    }
  }

  document.addEventListener('astro:page-load', initHomePage);
</script>
