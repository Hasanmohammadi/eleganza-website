---
import Header from './Header.astro';
import Hero from './Hero.astro';
import HeroStatement from './HeroStatement.astro';
import IndustryGrid from './IndustryGrid.astro';
import StorySection from './StorySection.astro';
import WhyChoose from './WhyChoose.astro';
import ProjectsSection from './ProjectsSection.astro';
import MarqueeTicker from './MarqueeTicker.astro';
import ContactSection from './ContactSection.astro';
import type { Locale } from '../../i18n/translations';
import type { HomeContent } from '../../i18n/home';

interface Props {
  lang: Locale;
  h: HomeContent;
}
const { lang, h } = Astro.props;
---

<div class="bg-charcoal">
  <Header lang={lang} h={h} />
  <Hero h={h} lang={lang} />
  <HeroStatement h={h} lang={lang} />
  <IndustryGrid h={h} lang={lang} />
  <StorySection h={h} lang={lang} />
  <WhyChoose h={h} lang={lang} />
  <ProjectsSection h={h} lang={lang} />
  <MarqueeTicker h={h} lang={lang} />
  <ContactSection h={h} lang={lang} />
</div>
