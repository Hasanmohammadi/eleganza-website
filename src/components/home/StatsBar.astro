---
import type { HomeContent } from '../../i18n/home';
interface Props { h: HomeContent }
const { h } = Astro.props;
---

<section class="reveal-section stats-section border-y border-platinum/10 bg-navy/20">
  <div class="max-w-7xl mx-auto px-6 md:px-10 py-10 md:py-12 grid grid-cols-2 md:grid-cols-4 gap-8">
    {h.stats.map((stat) => (
      <div class="stat-item text-center md:text-start">
        <div class="stat-value font-display text-3xl md:text-5xl text-gold-light" data-target={stat.value}>
          {stat.value}
        </div>
        <div class="mt-1 text-xs md:text-sm text-platinum">{stat.label}</div>
      </div>
    ))}
  </div>
</section>

<script>
  import gsap from 'gsap';

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const DIGIT_SETS: Record<string, string> = {
    latin: '0123456789',
    fa: '۰۱۲۳۴۵۶۷۸۹',
    ar: '٠١٢٣٤٥٦٧٨٩',
  };

  function normalizeDigit(ch: string): number | null {
    for (const set of Object.values(DIGIT_SETS)) {
      const idx = set.indexOf(ch);
      if (idx > -1) return idx;
    }
    return null;
  }

  function parseValue(raw: string) {
    let prefix = '';
    let suffix = '';
    let digits = '';
    let script: keyof typeof DIGIT_SETS = 'latin';
    let seenDigit = false;

    for (const ch of raw) {
      const n = normalizeDigit(ch);
      if (n !== null) {
        if (!seenDigit) {
          seenDigit = true;
          script = (Object.entries(DIGIT_SETS).find(([, set]) => set.includes(ch))?.[0] as keyof typeof DIGIT_SETS) ?? 'latin';
        }
        digits += n;
      } else if (!seenDigit) {
        prefix += ch;
      } else {
        suffix += ch;
      }
    }
    return { prefix, suffix, target: parseInt(digits || '0', 10), script };
  }

  function formatNumber(n: number, script: keyof typeof DIGIT_SETS): string {
    const set = DIGIT_SETS[script];
    return Math.round(n)
      .toString()
      .split('')
      .map((d) => set[+d])
      .join('');
  }

  function runCountUp() {
    document.querySelectorAll<HTMLElement>('.stat-value').forEach((el) => {
      const raw = el.dataset.target ?? el.textContent ?? '';
      const { prefix, suffix, target, script } = parseValue(raw);

      if (prefersReduced) {
        el.textContent = raw;
        return;
      }

      const counter = { val: 0 };
      gsap.to(counter, {
        val: target,
        duration: 1.6,
        ease: 'power2.out',
        onUpdate: () => {
          el.textContent = `${prefix}${formatNumber(counter.val, script)}${suffix}`;
        },
        onComplete: () => {
          el.textContent = raw; // اطمینان از دقیق بودن مقدار نهایی
        },
      });
    });
  }

  function initStatsBar() {
    const section = document.querySelector('.stats-section');
    if (section) {
      import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger);
        ScrollTrigger.create({
          trigger: section,
          start: 'top 80%',
          once: true,
          onEnter: runCountUp,
        });
      });
    }
  }

  document.addEventListener('astro:page-load', initStatsBar);
</script>
