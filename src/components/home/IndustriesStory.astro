---
import type { HomeContent } from '../../i18n/home';

interface Props {
  h: HomeContent;
}
const { h } = Astro.props;

const icons = [
  '<path d="M3 21h18"/><path d="M4 21V10"/><path d="M20 21V10"/><path d="M8 21V10"/><path d="M12 21V10"/><path d="M16 21V10"/><path d="M2 10l10-6 10 6"/>',
  '<path d="M4 18h16"/><path d="M6 18v-2a6 6 0 0 1 12 0v2"/><path d="M10 10V6"/><path d="M14 10V6"/><path d="M3 18h2"/><path d="M19 18h2"/>',
  '<rect x="6" y="3" width="12" height="18" rx="1"/><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1"/><path d="M3 21h18"/>',
  '<path d="M3 17l6-6 4 4 7-8"/><path d="M15 6h5v5"/>',
  '<path d="M12 22c4 0 6-3 6-6.5 0-2.5-1.5-4-2.5-5.5C14.5 8 14 6 14 4c-3 2-5 5-5 8-1-.5-1.5-2-1.5-3.5C5.5 10 5 12.5 5 15c0 3.5 3 7 7 7Z"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.5 4 5.7 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.7-4-9s1.5-6.5 4-9Z"/>',
];

const radius = 34; // درصد شعاع نسبت به کانتینر
const positions = h.industries.items.map((item, i) => {
  const angleDeg = -90 + i * 60;
  const angle = angleDeg * (Math.PI / 180);
  const x = 50 + radius * Math.cos(angle);
  const y = 50 + radius * Math.sin(angle);
  return { ...item, x, y, angle: angleDeg, icon: icons[i] };
});

// آماری که تو صحنه‌ی سوم بزرگ نمایش داده می‌شه
const spotlightStat = h.stats[1]; // "15+ Years of combined expertise"
---

<section id="industries" class="story-section relative" style="height: 400vh;">
  <div class="story-pin sticky top-0 h-screen w-full overflow-hidden flex items-center justify-center bg-navy/25 border-y border-platinum/10 pt-16 md:pt-20">
    <!-- هاله‌ی پس‌زمینه‌ی ثابت -->
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(212,175,55,0.08), transparent 70%);"></div>

    <!-- نشانگر پیشرفت داستان (۴ نقطه) -->
    <div class="story-progress absolute bottom-8 md:bottom-10 inset-x-0 flex justify-center gap-2.5 z-20">
      <span class="story-dot w-1.5 h-1.5 rounded-full bg-platinum/30"></span>
      <span class="story-dot w-1.5 h-1.5 rounded-full bg-platinum/30"></span>
      <span class="story-dot w-1.5 h-1.5 rounded-full bg-platinum/30"></span>
      <span class="story-dot w-1.5 h-1.5 rounded-full bg-platinum/30"></span>
    </div>

    <!-- صحنه ۱: چشم‌انداز -->
    <div class="story-scene story-scene-1 absolute inset-0 flex flex-col items-center justify-center text-center px-6">
      <img src="/brand/logo-icon.png" alt="" class="w-16 sm:w-20 mb-6 opacity-90" />
      <h2 class="font-display text-2xl sm:text-4xl md:text-5xl text-warmwhite max-w-xl">
        {h.industries.sectionTitle}
      </h2>
      <p class="mt-4 text-platinum text-sm sm:text-base max-w-md">{h.industries.sectionSubtitle}</p>
    </div>

    <!-- صحنه ۲: شش حوزه‌ی فعالیت دور نشان -->
    <div class="story-scene story-scene-2 absolute inset-0 flex items-center justify-center px-6">
      <div class="relative w-[280px] h-[280px] sm:w-[420px] sm:h-[420px] md:w-[480px] md:h-[480px]">
        <!-- نشان مرکزی -->
        <div class="absolute inset-0 flex items-center justify-center">
          <img src="/brand/logo-icon.png" alt="" class="w-12 sm:w-16 opacity-80" />
        </div>
        <!-- خطوط اتصال از مرکز به هر آیکون -->
        <svg viewBox="0 0 100 100" class="absolute inset-0 w-full h-full overflow-visible" preserveAspectRatio="none">
          {positions.map((p) => (
            <line
              class="story-line"
              x1="50"
              y1="50"
              x2={p.x}
              y2={p.y}
              stroke="#D4AF37"
              stroke-opacity="0.3"
              stroke-width="0.3"
            />
          ))}
        </svg>
        <!-- آیکون‌های شش‌گانه -->
        {positions.map((p) => (
          <div
            class="story-icon absolute flex flex-col items-center gap-1.5 -translate-x-1/2 -translate-y-1/2"
            style={`left:${p.x}%; top:${p.y}%`}
            data-angle={p.angle}
          >
            <span class="flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-charcoal border border-gold/50 text-gold">
              <svg viewBox="0 0 24 24" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
            </span>
            <span class="text-[10px] sm:text-xs text-platinum whitespace-nowrap">{p.title}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- صحنه ۳: آمار برجسته -->
    <div class="story-scene story-scene-3 absolute inset-0 flex flex-col items-center justify-center text-center px-6">
      <span class="story-stat-num font-display text-6xl sm:text-8xl md:text-9xl text-transparent bg-clip-text" style="background-image: linear-gradient(120deg, #F3E6B3, #D4AF37);" data-target={spotlightStat.value}>
        0
      </span>
      <span class="mt-3 text-platinum text-sm sm:text-lg tracking-wide">{spotlightStat.label}</span>
    </div>

    <!-- صحنه ۴: جمع‌بندی و CTA -->
    <div class="story-scene story-scene-4 absolute inset-0 flex flex-col items-center justify-center text-center px-6">
      <img src="/brand/logo-icon.png" alt="" class="w-14 sm:w-20 mb-6 opacity-90" />
      <h2 class="font-display text-2xl sm:text-4xl md:text-5xl text-warmwhite max-w-lg">
        {h.industries.sectionTitle} — {h.industries.sectionSubtitle}
      </h2>
      <a href="#business" class="story-cta relative overflow-hidden mt-8 px-7 py-3 text-sm font-medium tracking-wide text-charcoal">
        <span class="relative z-10">{h.explore.sectionTitle}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .story-scene {
    opacity: 0;
  }
  .story-cta {
    background: linear-gradient(135deg, #f3e6b3, #d4af37);
  }
  .story-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255, 255, 255, 0.55) 50%, transparent 70%);
    background-size: 250% 100%;
    background-position: 150% 0;
  }
  .story-cta:hover::after {
    transition: background-position 0.7s ease;
    background-position: -50% 0;
  }
  .story-dot.is-active {
    background-color: #d4af37;
  }

  /* برای کاربرانی که انیمیشن کمتر می‌خوان: بدون pin، ساده و پشت سرهم */
  @media (prefers-reduced-motion: reduce) {
    .story-section {
      height: auto !important;
    }
    .story-pin {
      position: static !important;
      height: auto !important;
      display: flex;
      flex-direction: column;
      gap: 4rem;
      padding-block: 4rem;
    }
    .story-scene {
      position: static !important;
      opacity: 1 !important;
    }
    .story-progress {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  function initIndustriesStory() {
    const section = document.querySelector('.story-section') as HTMLElement | null;
    if (!section) return;
    if (section.dataset.inited) return;
    section.dataset.inited = '1';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
      gsap.registerPlugin(ScrollTrigger);

      const dots = document.querySelectorAll('.story-dot');
      const icons = document.querySelectorAll<HTMLElement>('.story-icon');

      // آیکون‌ها اول وسط دایره (روی نشان مرکزی) قرار می‌گیرن تا موقع ورود «منفجر» بشن بیرون
      icons.forEach((icon) => {
        const angle = (parseFloat(icon.dataset.angle || '0') * Math.PI) / 180;
        const burst = 70; // فاصله‌ی شروع از مرکز (px)
        gsap.set(icon, {
          x: -Math.cos(angle) * burst,
          y: -Math.sin(angle) * burst,
          scale: 0.2,
          opacity: 0,
        });
      });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.6,
          pin: '.story-pin',
          onUpdate: (self) => {
            const idx = Math.min(3, Math.floor(self.progress * 4));
            dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
          },
        },
      });

      // صحنه ۱ → ۲
      tl.set('.story-scene-1', { opacity: 1 })
        .to('.story-scene-1', { opacity: 0, duration: 0.6 }, 0.55)
        .to('.story-scene-2', { opacity: 1, duration: 0.6 }, 0.55)
        .to(icons, { x: 0, y: 0, scale: 1, opacity: 1, stagger: 0.08, duration: 0.9, ease: 'back.out(2)' }, 0.75)
        .fromTo('.story-line', { scaleX: 0 }, { scaleX: 1, stagger: 0.08, duration: 0.7, transformOrigin: 'left center' }, 0.75)
        // صحنه ۲ → ۳
        .to('.story-scene-2', { opacity: 0, duration: 0.6 }, 2.3)
        .to('.story-scene-3', { opacity: 1, duration: 0.6 }, 2.3)
        // صحنه ۳ → ۴
        .to('.story-scene-3', { opacity: 0, duration: 0.6 }, 3.3)
        .to('.story-scene-4', { opacity: 1, duration: 0.6 }, 3.3);

      // شمارش عدد صحنه‌ی ۳ (فقط یک‌بار، وقتی صحنه فعال می‌شه)
      const statEl = document.querySelector('.story-stat-num') as HTMLElement | null;
      if (statEl) {
        const raw = statEl.dataset.target || '0';
        const digits = raw.replace(/[^\d]/g, '');
        const suffix = raw.replace(/[\d]/g, '');
        const target = parseInt(digits || '0', 10);
        let played = false;

        ScrollTrigger.create({
          trigger: section,
          start: 'top top',
          end: 'bottom bottom',
          onUpdate: (self) => {
            if (!played && self.progress > 0.58 && self.progress < 0.85) {
              played = true;
              const counter = { val: 0 };
              gsap.to(counter, {
                val: target,
                duration: 1.4,
                ease: 'power2.out',
                onUpdate: () => {
                  statEl.textContent = `${Math.round(counter.val)}${suffix}`;
                },
              });
            }
            if (self.progress < 0.5) played = false; // اگه برگشت بالا، دوباره آماده بشه
          },
        });
      }
    });
  }

  document.addEventListener('astro:page-load', initIndustriesStory);
</script>
