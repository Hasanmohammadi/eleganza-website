---
import type { HomeContent } from '../../i18n/home';

import type { Locale } from '../../i18n/translations';
import IndustriesStory from './IndustriesStory.astro';

interface Props {
  h: HomeContent;
  lang: Locale;
}
const { h, lang } = Astro.props;
const dir = lang === 'en' ? 'ltr' : 'rtl';
const isLatin = lang === 'en';
---

<!-- یک سکشن واحد: عکس بکگراند + لوگو/شعار، و بعد با اسکرول صحنه‌ها روی همون بکگراند (سمت چپ) -->
<section id="home" class="hero-section story-section relative" style="height: 400vh;">
 <div class="hero-pin sticky top-0 h-screen w-full overflow-hidden isolate flex items-center">
  <div class="hero-bg-wrap absolute inset-0 -z-10">
    <!-- پارالاکس روی این لایه؛ Ken Burns روی خود عکس (تداخل transform نداشته باشن) -->
    <div class="hero-parallax absolute inset-0">
      <picture>
        <source media="(max-width: 767px)" srcset="/mock/hero-mobile.jpg" />
        <img src="/mock/hero-desktop.jpg" alt="" class="hero-bg-img w-full h-full object-cover" fetchpriority="high" />
      </picture>
    </div>
    <!-- سایه‌ی ملایم: سمت چپ (محل لوگو) کمی تیره‌تر، بقیه روشن؛ پایین برای اتصال به سکشن بعدی -->
    <div class="hero-shade absolute inset-0"></div>
  </div>

  <!-- بلوک لوگو + شعار همیشه سمت چپِ صفحه‌ست (برای fa/ar هم) -->
  <div class="hero-scene-0 relative z-[5] w-full px-6 md:px-10 pt-24 pb-24 md:pb-28" dir="ltr">
    <div class="hero-brand mx-auto md:mx-0 md:ml-[4vw] lg:ml-[7vw] flex flex-col items-center text-center w-full max-w-[22rem] md:max-w-[30rem] lg:max-w-[34rem]">
      <img src="/brand/logo-full.png" alt="Eleganza United Business" width="640" height="482"
           class="hero-logo opacity-0 w-[68%] md:w-[82%] h-auto drop-shadow-[0_8px_40px_rgba(0,0,0,0.45)]" />
      <span class="hero-rule opacity-0 mt-7 md:mt-9 block h-px w-24 md:w-32 bg-gradient-to-r from-transparent via-gold to-transparent"></span>
      <p class="hero-slogan mt-6 md:mt-7 font-display text-warmwhite text-2xl sm:text-3xl md:text-4xl leading-snug drop-shadow-[0_2px_18px_rgba(0,0,0,0.55)]"
         dir={dir} lang={lang}>
        <span class="hero-slogan-line line-mask block"><span class="hero-slogan-inner block">{h.hero.slogan1}</span></span>
        <span class="hero-slogan-line line-mask block"><span class="hero-slogan-inner hero-highlight block bg-clip-text text-transparent" style="background-image: linear-gradient(120deg, #F3E6B3, #D4AF37);">{h.hero.slogan2}</span></span>
      </p>
      <div class="hero-ctas opacity-0 mt-9 flex flex-col sm:flex-row gap-3 md:gap-4 w-full sm:w-auto" dir={dir}>
        <a href="#industries" class={`magnetic-btn hero-btn hero-btn-solid inline-flex items-center justify-center gap-3 px-7 py-3.5 rounded-full text-[12px] md:text-[13px] font-semibold text-charcoal ${isLatin ? 'uppercase tracking-[0.18em]' : ''}`}>
          <span class="magnetic-btn-inner inline-flex items-center gap-3">{h.hero.ctaPrimary}<svg class="hero-arrow w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
        </a>
        <a href="#contact" class={`magnetic-btn hero-btn hero-btn-outline inline-flex items-center justify-center px-7 py-3.5 rounded-full border border-gold/70 text-gold-light text-[12px] md:text-[13px] font-medium backdrop-blur-sm ${isLatin ? 'uppercase tracking-[0.18em]' : ''}`}>
          <span class="magnetic-btn-inner inline-block">{h.hero.ctaSecondary}</span>
        </a>
      </div>
    </div>
  </div>


  <IndustriesStory h={h} />
 </div>
</section>

<style>
  .hero-btn-solid {
    background: linear-gradient(135deg, #f3e6b3, #e2bf6a 55%, #d4af37);
    box-shadow: 0 10px 30px -12px rgba(212, 175, 55, 0.6);
  }
  .hero-btn-outline {
    background: rgba(11, 11, 11, 0.25);
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .hero-btn-outline:hover {
    background: linear-gradient(135deg, #f3e6b3, #d4af37);
    color: #111;
    border-color: transparent;
  }
  :global([dir='rtl']) .hero-arrow {
    transform: scaleX(-1);
  }
  .hero-bg-img {
    animation: kenburns 24s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    from { transform: scale(1) translate(0, 0); }
    to { transform: scale(1.08) translate(-1%, -1%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-img { animation: none; }
    .hero-section { height: auto !important; }
    .hero-pin { position: static !important; height: auto !important; min-height: 100vh; flex-direction: column; justify-content: center; }
  }
  .hero-shade {
    background:
      linear-gradient(90deg, rgba(13,13,13,0.62) 0%, rgba(13,13,13,0.30) 42%, rgba(13,13,13,0) 70%),
      linear-gradient(180deg, rgba(13,13,13,0.18) 0%, rgba(13,13,13,0) 35%, rgba(13,13,13,0.85) 100%);
  }
  @media (max-width: 767px) {
    .hero-shade {
      background: linear-gradient(180deg, rgba(13,13,13,0.50) 0%, rgba(13,13,13,0.50) 55%, rgba(13,13,13,0.88) 100%);
    }
  }
</style>

<script>
  import gsap from 'gsap';

  function initHero() {
    const heroSection = document.querySelector('.hero-section');
    if (!heroSection) return; // این صفحه هیرو نداره (مثلاً صفحه‌ی Coming Soon)
    if ((heroSection as HTMLElement).dataset.inited) return;
    (heroSection as HTMLElement).dataset.inited = '1';

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---------- تایم‌لاین ورود قوی‌تر (ماسک‌دار برای عنوان) ----------
    gsap.set('.hero-slogan-inner', { yPercent: 170, rotate: 3 });
    const tl = gsap.timeline({ defaults: { ease: 'power4.out' }, delay: 0.15 });
    tl.fromTo('.hero-logo', { opacity: 0, y: 24, scale: 0.94 }, { opacity: 1, y: 0, scale: 1, duration: 1.3, ease: 'expo.out' })
      .fromTo('.hero-rule', { opacity: 0, scaleX: 0 }, { opacity: 1, scaleX: 1, duration: 0.8 }, '-=0.7')
      .to('.hero-slogan-inner', { yPercent: 0, rotate: 0, duration: 1.1, stagger: 0.14, ease: 'expo.out' }, '-=0.5')
      .fromTo('.hero-ctas', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8 }, '-=0.5');

    // ---------- دکمه‌های مگنتیک ----------
    if (!prefersReduced && window.matchMedia('(hover: hover)').matches) {
      document.querySelectorAll<HTMLElement>('.magnetic-btn').forEach((btn) => {
        const inner = btn.querySelector<HTMLElement>('.magnetic-btn-inner');
        const xTo = gsap.quickTo(btn, 'x', { duration: 0.5, ease: 'power3.out' });
        const yTo = gsap.quickTo(btn, 'y', { duration: 0.5, ease: 'power3.out' });
        const xToInner = inner ? gsap.quickTo(inner, 'x', { duration: 0.5, ease: 'power3.out' }) : null;
        const yToInner = inner ? gsap.quickTo(inner, 'y', { duration: 0.5, ease: 'power3.out' }) : null;

        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const relX = e.clientX - rect.left - rect.width / 2;
          const relY = e.clientY - rect.top - rect.height / 2;
          xTo(relX * 0.35);
          yTo(relY * 0.5);
          xToInner?.(relX * 0.16);
          yToInner?.(relY * 0.22);
        });
        btn.addEventListener('mouseleave', () => {
          xTo(0);
          yTo(0);
          xToInner?.(0);
          yToInner?.(0);
        });
      });
    }
  }

  document.addEventListener('astro:page-load', initHero);
</script>
