---
import type { HomeContent } from '../../i18n/home';
interface Props { h: HomeContent }
const { h } = Astro.props;

const icons = [
  '<path d="M3 21h18"/><path d="M4 21V10"/><path d="M20 21V10"/><path d="M8 21V10"/><path d="M12 21V10"/><path d="M16 21V10"/><path d="M2 10l10-6 10 6"/>',
  '<path d="M4 18h16"/><path d="M6 18v-2a6 6 0 0 1 12 0v2"/><path d="M10 10V6"/><path d="M14 10V6"/><path d="M3 18h2"/><path d="M19 18h2"/>',
  '<rect x="6" y="3" width="12" height="18" rx="1"/><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1"/><path d="M3 21h18"/>',
  '<path d="M3 17l6-6 4 4 7-8"/><path d="M15 6h5v5"/>',
  '<path d="M12 22c4 0 6-3 6-6.5 0-2.5-1.5-4-2.5-5.5C14.5 8 14 6 14 4c-3 2-5 5-5 8-1-.5-1.5-2-1.5-3.5C5.5 10 5 12.5 5 15c0 3.5 3 7 7 7Z"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.5 4 5.7 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.7-4-9s1.5-6.5 4-9Z"/>',
];
---

<section id="industries" class="reveal-section bg-navy/15 border-y border-platinum/10">
  <div class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24">
    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-warmwhite">{h.industries.sectionTitle}</h2>
      <p class="mt-3 text-platinum text-sm md:text-base">{h.industries.sectionSubtitle}</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {h.industries.items.map((item, i) => (
        <div class="industry-card p-6 md:p-8 border border-platinum/10 hover:border-gold/40 transition-colors bg-charcoal/40">
          <span class="inline-flex items-center justify-center w-11 h-11 md:w-12 md:h-12 rounded-full bg-navy border border-gold/40 text-gold mb-5">
            <svg viewBox="0 0 24 24" class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
          </span>
          <h3 class="font-display text-lg md:text-xl text-warmwhite mb-2">{item.title}</h3>
          <p class="text-sm text-platinum leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
