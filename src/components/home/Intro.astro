---
import type { HomeContent } from '../../i18n/home';
interface Props { h: HomeContent }
const { h } = Astro.props;
---

<section id="about" class="reveal-section max-w-4xl mx-auto px-6 md:px-10 py-20 md:py-28 text-center">
  <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-warmwhite">{h.intro.title}</h2>
  <p class="mt-6 text-platinum text-base md:text-lg leading-relaxed">{h.intro.body}</p>
  <a href="#industries" class="inline-block mt-8 text-sm tracking-wide text-gold border-b border-gold/50 hover:border-gold pb-1 transition-colors">
    {h.intro.cta} &rarr;
  </a>
</section>
