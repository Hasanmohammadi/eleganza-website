---
import type { HomeContent } from '../../i18n/home';
interface Props { h: HomeContent }
const { h } = Astro.props;

// هدلاین رو کلمه‌به‌کلمه می‌شکنیم تا هرکدوم جدا انیمیت بشه
const words = h.intro.title.split(' ');
---

<section id="about" class="reveal-section max-w-4xl mx-auto px-6 md:px-10 py-20 md:py-28 text-center">
  <h2 class="intro-heading font-display text-2xl sm:text-3xl md:text-4xl text-warmwhite">
    {words.map((word) => (
      <span class="intro-word inline-block overflow-hidden align-top">
        <span class="intro-word-inner inline-block">{word}</span>
      </span>
    ))}
  </h2>
  <p class="intro-body opacity-0 mt-6 text-platinum text-base md:text-lg leading-relaxed">{h.intro.body}</p>
  <a href="#industries" class="intro-cta opacity-0 inline-block mt-8 text-sm tracking-wide text-gold border-b border-gold/50 hover:border-gold pb-1 transition-colors">
    {h.intro.cta} &rarr;
  </a>
</section>

<style>
  .intro-word {
    margin-inline-end: 0.32em;
  }
</style>

<script>
  import gsap from 'gsap';

  function initIntro() {
    const section = document.getElementById('about');
    if (!section) return;

    import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
      gsap.registerPlugin(ScrollTrigger);

      gsap.set('.intro-word-inner', { yPercent: 110, opacity: 0 });
      gsap.set('.intro-body, .intro-cta', { y: 16 });

      const tl = gsap.timeline({
        scrollTrigger: { trigger: section, start: 'top 78%', once: true },
        defaults: { ease: 'power3.out' },
      });

      tl.to('.intro-word-inner', { yPercent: 0, opacity: 1, duration: 0.7, stagger: 0.045 })
        .to('.intro-body', { opacity: 1, y: 0, duration: 0.7 }, '-=0.3')
        .to('.intro-cta', { opacity: 1, y: 0, duration: 0.6 }, '-=0.4');
    });
  }

  document.addEventListener('astro:page-load', initIntro);
</script>
