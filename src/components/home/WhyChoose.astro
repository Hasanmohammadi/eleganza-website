---
import type { HomeContent } from '../../i18n/home';
interface Props { h: HomeContent }
const { h } = Astro.props;

const icons = [
  '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>',
  '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.5 4 5.7 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.7-4-9s1.5-6.5 4-9Z"/>',
  '<path d="M12 3 3 7v5c0 5 4 8 9 9 5-1 9-4 9-9V7l-9-4Z"/>',
  '<circle cx="9" cy="8" r="3"/><path d="M2 21v-1a5 5 0 0 1 5-5h1a5 5 0 0 1 5 5v1"/><circle cx="18" cy="9" r="2.5"/><path d="M15.5 21v-1a4 4 0 0 1 4-4h.5a4 4 0 0 1 3 1.3"/>',
  '<path d="M3 17l4-8 4 5 3-6 4 4 3-3"/><circle cx="19" cy="6" r="2"/>',
];
---

<section class="reveal-section max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24">
  <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-warmwhite text-center mb-12 md:mb-16">
    {h.whyChoose.sectionTitle}
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
    {h.whyChoose.features.map((f, i) => (
      <div class="feature-item flex flex-col items-center text-center gap-3 px-4">
        <span class="feature-icon inline-flex items-center justify-center w-14 h-14 rounded-full border border-gold/25 text-gold transition-all duration-300">
          <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
        </span>
        <h3 class="font-display text-base md:text-lg text-warmwhite">{f.title}</h3>
        <p class="text-sm text-platinum leading-relaxed max-w-xs">{f.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .feature-item:hover .feature-icon {
    transform: scale(1.12) rotate(-6deg);
    border-color: rgba(212, 175, 55, 0.7);
    background: rgba(212, 175, 55, 0.08);
  }
</style>
