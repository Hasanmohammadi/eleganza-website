---
import type { HomeContent } from '../../i18n/home';
import type { Locale } from '../../i18n/translations';

interface Props {
  h: HomeContent;
  lang: Locale;
}
const { h, lang } = Astro.props;
const isLatin = lang === 'en';
const w = h.whyChoose;

// آیکون‌ها: ستاره، تیم، الماس، چرخ‌دنده، دست‌دادن، نمودار رشد
const icons = [
  '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/>',
  '<circle cx="12" cy="7.5" r="2.6"/><path d="M7.5 19v-1.5a4.5 4.5 0 0 1 9 0V19"/><circle cx="5.2" cy="9.5" r="2"/><path d="M2 18v-1a3.3 3.3 0 0 1 4.6-3"/><circle cx="18.8" cy="9.5" r="2"/><path d="M22 18v-1a3.3 3.3 0 0 0-4.6-3"/>',
  '<path d="M6.5 4h11L21 9l-9 11L3 9l3.5-5Z"/><path d="M3 9h18"/><path d="m9.5 4-1.5 5 4 11 4-11-1.5-5"/>',
  '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/>',
  '<path d="m11 17 2 2a1.4 1.4 0 0 0 2-2"/><path d="m14 14 2.5 2.5a1.4 1.4 0 0 0 2-2l-3.9-3.9a2 2 0 0 0-2.8 0l-.9.9a1.4 1.4 0 0 1-2-2l2.8-2.8a3.2 3.2 0 0 1 3.8-.5l.5.3a2.2 2.2 0 0 0 1.4.3H21"/><path d="m21 14-1.6 1.6"/><path d="M3 7h3.2a2 2 0 0 1 1.4.6L10 10"/><path d="m3 14 5.5 5.5a1.4 1.4 0 0 0 2-2"/>',
  '<path d="M3 21h18"/><path d="M5 21v-5h3v5"/><path d="M10.5 21v-8h3v8"/><path d="M16 21v-11h3v11"/><path d="m4 11 5-4 4 2.5L20 4"/><path d="M16.5 4H20v3.5"/>',
];

// عکس‌ها: public/why/why-1.jpg … why-6.jpg (موقتی؛ با همین اسم جایگزین کن)
const cards = w.features.map((f, i) => ({
  ...f,
  num: String(i + 1).padStart(2, '0'),
  icon: icons[i],
  image: `/why/why-${i + 1}.jpg`,
}));
---

<!-- سکشن «چرا الگانزا»: هدر + شش کارت عمودی (متن بالا، عکس پایین) -->
<section id="why" class="why-sec relative overflow-hidden py-20 md:py-28">
  <div class="why-bg pointer-events-none absolute inset-0"></div>

  <div class="relative max-w-[100rem] mx-auto px-5 md:px-8 xl:px-10">
    <div class="mb-12 md:mb-14 lg:px-12">
      <div class="why-reveal flex items-center gap-4 mb-6">
        <span class="why-rule block h-px w-12 md:w-16 bg-gold/80 shrink-0"></span>
        <span class={`text-[11px] md:text-[13px] font-medium text-gold-light ${isLatin ? 'uppercase tracking-[0.3em]' : ''}`}>{w.eyebrow}</span>
      </div>
      <h2 class="font-display text-warmwhite text-[2.4rem] leading-[1.08] sm:text-6xl lg:text-7xl">
        <span class="why-line line-mask block"><span class="why-line-inner block">{w.title}</span></span>
        <span class="why-line line-mask block">
          <span class="why-line-inner block bg-clip-text text-transparent" style="background-image: linear-gradient(100deg, #F3E6B3 0%, #E6C878 45%, #D4AF37 100%);">{w.highlight}</span>
        </span>
      </h2>
      <p class="why-reveal mt-5 md:mt-6 text-platinum/90 text-[0.95rem] md:text-lg leading-[1.7] max-w-[38rem]">{w.subtitle}</p>
    </div>

    <div class="why-grid grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
      {cards.map((c) => (
        <article class="why-card group relative flex flex-col overflow-hidden rounded-[6px] border border-white/[0.07]">
          <div class="why-body relative flex-1 p-6 xl:p-[1.4rem] 2xl:p-6">
            <div class="flex items-center gap-3 text-gold-light text-[15px]" dir="ltr">
              <span>{c.num}</span>
              <span class="why-num-rule block h-px w-10 bg-gold/60 transition-all duration-500"></span>
            </div>
            <svg viewBox="0 0 24 24" class="why-icon mt-4 w-11 h-11 text-gold" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} aria-hidden="true" />
            <h3 class="font-display mt-4 text-[1.55rem] xl:text-[1.45rem] 2xl:text-[1.65rem] leading-[1.12] text-warmwhite">{c.title}</h3>
            <p class="mt-3 text-[13.5px] xl:text-[13px] 2xl:text-[13.5px] leading-[1.6] text-platinum/90">{c.description}</p>
          </div>
          <div class="why-media relative overflow-hidden">
            <img src={c.image} alt="" loading="lazy" decoding="async" class="why-img absolute inset-0 w-full h-full object-cover" />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why-bg {
    background:
      radial-gradient(ellipse 40% 50% at 78% 6%, rgba(212, 175, 55, 0.09), transparent 70%),
      radial-gradient(ellipse 55% 50% at 10% 80%, rgba(11, 31, 58, 0.25), transparent 70%),
      linear-gradient(180deg, #0b0b0b, #0d0f13 50%, #0b0b0b);
  }
  .why-card {
    background: linear-gradient(180deg, #141518 0%, #0f1012 100%);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.4s ease, box-shadow 0.5s ease;
  }
  .why-media {
    aspect-ratio: 16 / 10;
  }
  /* موبایل: کارت‌ها کنار هم و قابل سوایپ (به‌جای یه ستون خیلی بلند) */
  @media (max-width: 639px) {
    .why-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
      padding-bottom: 0.5rem;
      scroll-padding-inline: 1.25rem;
      scrollbar-width: none;
    }
    .why-grid::-webkit-scrollbar {
      display: none;
    }
    .why-card {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
  }
  @media (min-width: 1280px) {
    .why-media {
      aspect-ratio: 4 / 3.1;
    }
  }
  .why-img {
    transform: scale(1.02);
    filter: brightness(0.92);
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.6s ease;
  }
  .why-card:hover {
    transform: translateY(-6px);
    border-color: rgba(212, 175, 55, 0.4);
    box-shadow: 0 26px 60px -28px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(212, 175, 55, 0.08);
  }
  .why-card:hover .why-img {
    transform: scale(1.1);
    filter: brightness(1.02);
  }
  .why-card:hover .why-num-rule {
    width: 3.5rem;
    background-color: #d4af37;
  }
  .why-icon {
    transition: transform 0.5s cubic-bezier(0.3, 1.5, 0.5, 1), filter 0.4s ease;
  }
  .why-card:hover .why-icon {
    transform: translateY(-2px) scale(1.08);
    filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.55));
  }
  @media (prefers-reduced-motion: reduce) {
    .why-card, .why-img, .why-icon { transition: none; }
    .why-card:hover { transform: none; }
  }
</style>

<script>
  import gsap from 'gsap';

  function initWhy() {
    const section = document.querySelector('.why-sec') as HTMLElement | null;
    if (!section || section.dataset.inited) return;
    section.dataset.inited = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
      gsap.registerPlugin(ScrollTrigger);
      const isRtl = document.documentElement.dir === 'rtl';

      gsap.timeline({ defaults: { ease: 'power3.out' }, scrollTrigger: { trigger: section, start: 'top 75%', once: true } })
        .from(section.querySelector('.why-rule'), { scaleX: 0, transformOrigin: isRtl ? 'right center' : 'left center', duration: 0.8 }, 0)
        .from(section.querySelectorAll('.why-line-inner'), { yPercent: 165, duration: 1.1, stagger: 0.12, ease: 'expo.out' }, 0.1)
        .from(section.querySelectorAll('.why-reveal'), { opacity: 0, y: 22, duration: 0.9, stagger: 0.12 }, 0.2);

      // آیکون‌ها با خط‌کشی
      const iconParts = section.querySelectorAll<SVGElement>('.why-icon *');
      iconParts.forEach((el) => el.setAttribute('pathLength', '1'));
      gsap.set(iconParts, { strokeDasharray: 1, strokeDashoffset: 1 });

      // کارت‌ها: موج از اول به آخر؛ عکس از پایین باز می‌شه
      const cards = section.querySelectorAll<HTMLElement>('.why-card');
      gsap.timeline({ scrollTrigger: { trigger: section.querySelector('.why-grid'), start: 'top 82%', once: true } })
        .from(cards, { opacity: 0, y: 50, duration: 1, stagger: 0.1, ease: 'power3.out' }, 0)
        .from(section.querySelectorAll('.why-media'), { clipPath: 'inset(100% 0 0 0)', duration: 1.2, stagger: 0.1, ease: 'expo.inOut', clearProps: 'clipPath' }, 0.2)
        .to(iconParts, { strokeDashoffset: 0, duration: 1.1, stagger: 0.02, ease: 'power2.inOut' }, 0.35);
    });
  }

  document.addEventListener('astro:page-load', initWhy);
</script>
