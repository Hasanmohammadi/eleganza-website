---
import EmblemMark from '../EmblemMark.astro';
import type { Locale } from '../../i18n/translations';
import type { HomeContent } from '../../i18n/home';

interface Props {
  lang: Locale;
  h: HomeContent;
}
const { lang, h } = Astro.props;

const socials = [
  { name: 'LinkedIn', path: '<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.3c0-1.26-.02-2.88-1.76-2.88-1.76 0-2.03 1.37-2.03 2.79V21H9z"/>' },
  { name: 'Instagram', path: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>' },
  { name: 'X', path: '<path d="M4 4l16 16M20 4L4 20"/>' },
];
---

<footer class="footer-reveal opacity-0 border-t border-platinum/10 bg-charcoal">
  <div class="max-w-7xl mx-auto px-6 md:px-10 pt-16 md:pt-20 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr_1fr_1fr] gap-10 md:gap-8 pb-12 border-b border-platinum/10">
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <EmblemMark class="w-8 h-8" />
          <span class="font-display text-base tracking-widest2 uppercase text-warmwhite">Eleganza</span>
        </div>
        <p class="text-sm text-platinum max-w-xs leading-relaxed">{h.footer.tagline}</p>
        <div class="flex gap-3 mt-6">
          {socials.map((s) => (
            <a href="#" aria-label={s.name} class="w-9 h-9 flex items-center justify-center rounded-full border border-platinum/20 text-platinum hover:border-gold hover:text-gold transition-colors">
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.path} />
            </a>
          ))}
        </div>
      </div>

      {h.footer.columns.map((col) => (
        <div>
          <h4 class="text-xs tracking-widest2 uppercase text-gold mb-4">{col.title}</h4>
          <ul class="flex flex-col gap-2.5">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-platinum hover:text-warmwhite transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-platinum/60">
      <p>&copy; {new Date().getFullYear()} {h.footer.copyright}</p>
      <div class="flex gap-5">
        {h.footer.legalLinks.map((l) => <a href={l.href} class="hover:text-platinum transition-colors">{l.label}</a>)}
      </div>
    </div>

    <p class="mt-6 text-center text-[11px] text-gold/50 border-t border-platinum/10 pt-4">
      {h.footer.mockNotice}
    </p>
  </div>
</footer>

<script>
  import gsap from 'gsap';

  function initFooter() {
    const footer = document.querySelector('.footer-reveal');
    if (!footer) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      gsap.set(footer, { opacity: 1 });
      return;
    }

    import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
      gsap.registerPlugin(ScrollTrigger);
      gsap.fromTo(
        footer,
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: footer, start: 'top 90%', once: true } }
      );
    });
  }

  document.addEventListener('astro:page-load', initFooter);
</script>
